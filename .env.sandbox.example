# Configuration du site marchand de test.
# Ce fichier sert de modele. Copiez-le vers .env.sandbox puis adaptez si besoin.

# Port interne du site marchand de test.
PORT_SANDBOX=4000

# URL publique du site marchand de test vue par le navigateur.
# Sert aussi de base pour urlRetour apres reception du justificatif.
# Scenario local: http://localhost:4000
# Scenario test telephone via Tailscale: http://ADRESSE_TAILSCALE:4000
# Scenario distant: utilisez le domaine public du site de test.
URL_SANDBOX_PUBLIC=http://localhost:4000

# URL utilisee par le sandbox pour appeler l'API Paie Server.
# Scenario local sans Docker: http://localhost:3000
# Scenario Docker: docker-compose remplace par http://paie-server-application:3000
URL_API_PAIEMENT_INTERNE=http://localhost:3000

# Cle interne de classement sandbox.
# Si le sandbox est lance sans charger .env, mettez ici la meme valeur que CLE_ORIGINE_SANDBOX dans .env.
# Ne pas transmettre cette cle aux vraies applications marchandes.
CLE_ORIGINE_SANDBOX=remplacer_par_la_meme_cle_interne_sandbox

# URL de reception des notifications apres decision marchand.
# Scenario local sans Docker: http://localhost:4000/webhook/paiement
# Scenario Docker: docker-compose remplace par http://paie-server-sandbox:4000/webhook/paiement
URL_SANDBOX_WEBHOOK=http://localhost:4000/webhook/paiement

# Secret utilise pour verifier la signature x-signature-paiement.
# Le meme secret est envoye a Paie Server lors de la creation du paiement sandbox.
SECRET_WEBHOOK_SANDBOX=remplacer_par_un_secret_webhook_sandbox

# Identifiant client fictif utilise par les commandes du sandbox.
ID_CLIENT_SANDBOX=client_sandbox_demo
