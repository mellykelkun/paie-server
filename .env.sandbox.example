# Configuration du site marchand de test.
# Ce fichier sert au demarrage du processus sandbox.
# Les URLs, le secret webhook et l'ID client sandbox se configurent ensuite dans:
# http://localhost:7821/marchand/configuration

# Port interne du site marchand de test.
# En Docker, il reste interne au conteneur. Le port visible sur la machine
# est PORT_PUBLIC_SANDBOX dans .env, par defaut http://localhost:7822.
PORT_SANDBOX=4000
