# Configuration principale de Paie Server.
# Ce fichier sert de modele. Copiez-le vers .env puis adaptez les valeurs.

# Port interne ecoute par l'application Node.
# Scenario Docker: laissez 3000, Docker expose ensuite PORT_PUBLIC_APPLICATION.
# Scenario local sans Docker: ouvrez http://localhost:3000.
PORT=3000

# Port expose sur votre machine pour Paie Server quand Docker est utilise.
# Changez-le seulement si le port 3000 est deja utilise par un autre projet.
PORT_PUBLIC_APPLICATION=3000
PORT_PUBLIC_APPLICATION_TAILSCALE=3000

# Port expose sur votre machine pour le site marchand de test.
# Changez-le seulement si le port 4000 est deja utilise.
PORT_PUBLIC_SANDBOX=4000
PORT_PUBLIC_SANDBOX_TAILSCALE=4000

# Adresse privee Tailscale de la machine.
# Pour la trouver: tailscale ip -4
# Scenario local sans Tailscale: laissez 127.0.0.2 pour eviter une exposition Wi-Fi.
# Scenario test telephone: mettez l'adresse 100.x.y.z de cette machine.
ADRESSE_TAILSCALE=127.0.0.2

# URL publique de Paie Server, utilisee pour generer urlPaiement.
# Scenario local: http://localhost:3000
# Scenario test telephone via Tailscale: http://ADRESSE_TAILSCALE:3000
# Scenario production: https://pay.votre-domaine.com
# Important: si le client ou le site marchand est externe, n'utilisez pas localhost.
URL_PUBLIQUE_APPLICATION=http://localhost:3000

# Ancien nom garde par compatibilite.
# Priorite: URL_PUBLIQUE_APPLICATION > URL_BASE > http://localhost:PORT
URL_BASE=http://localhost:3000

# Cle secrete utilisee par les sites/apps marchands pour creer des paiements.
# A envoyer dans le header x-cle-api.
# Ne jamais exposer dans le navigateur.
CLE_API_APPLICATION=remplacer_par_une_cle_application_longue

# Cle interne optionnelle utilisee par le sandbox pour que Paie Server marque l'origine "sandbox".
# Ne la donnez pas aux applications marchandes reelles.
CLE_ORIGINE_SANDBOX=remplacer_par_une_cle_interne_sandbox_longue

# Cle secrete du tableau marchand Paie Server.
# Compatibilite API serveur-a-serveur uniquement: envoyer dans le header x-cle-marchand.
# Ne plus utiliser dans l'URL du navigateur.
CLE_MARCHAND=remplacer_par_une_cle_marchand_longue

# Mode d'execution.
# developpement: localhost/http autorises pour le sandbox.
# production: HTTPS obligatoire pour les URLs externes et blocage localhost/IP privees.
ENVIRONNEMENT=developpement

# Cle optionnelle pour proteger la premiere initialisation du compte marchand.
# Scenario dev local: peut rester vide.
# Scenario production: mettez une valeur longue et gardez-la hors navigateur.
CLE_INSTALLATION_MARCHAND=

# Secret de signature des sessions navigateur du tableau marchand.
# Utilisez une valeur aleatoire longue en production.
SECRET_SESSION_MARCHAND=remplacer_par_un_secret_session_long

# Duree d'inactivite avant deconnexion automatique du tableau marchand.
DUREE_SESSION_MARCHAND_MINUTES=30

# Cookie Secure force.
# true en production derriere HTTPS. false possible en local HTTP.
COOKIE_SECURISE=false

# Notifications envoyees au site/application marchand apres acceptation/refus.
# Les erreurs sont visibles cote tableau marchand, jamais cote client.
MAX_TENTATIVES_WEBHOOK=5
DELAI_RETRY_WEBHOOK_SECONDES=60

# Controle OCR et forensique des justificatifs.
# true: le serveur lit le texte du recu, controle la structure du service de paiement et cherche les traces fortes
# de generation IA ou d'edition externe dans le fichier image.
# OCR_PREUVE_OBLIGATOIRE=true bloque l'envoi si la lecture OCR echoue.
OCR_PREUVE_ACTIVE=true
OCR_PREUVE_OBLIGATOIRE=true
OCR_ZONES_ACTIVE=true

# Tolerance de difference entre le montant de commande et le montant lu sur le recu.
# Scenario frais du service de paiement: 30 accepte un ecart maximum de 30%.
# Exemple: commande 15000, un montant lu entre 15000 et 19500 reste acceptable.
# Un montant inferieur a 15000 est refuse.
TOLERANCE_FRAIS_MONTANT_POURCENT=30

# Controle des images uploadees.
# MAX_PIXELS_PREUVE evite les images geantes qui peuvent saturer l'OCR.
# Les seuils de distance servent a detecter une preuve visuellement proche d'une preuve deja recue.
MAX_PIXELS_PREUVE=6000000
SEUIL_DISTANCE_PHASH=8
SEUIL_DISTANCE_DHASH=32
SEUIL_DISTANCE_AHASH=38
SEUIL_SIMILARITE_TEXTE_PREUVE=0.82

# Delai de tolerance pour la date lue sur le recu.
# Exemple: 12 accepte un recu cree au plus 12h avant la creation du paiement.
DELAI_RECU_AVANT_CREATION_HEURES=12

# Connexion PostgreSQL.
# Scenario local sans Docker: HOTE_BASE_DE_DONNEES=localhost
# Scenario Docker: docker-compose remplace l'hote par paie-server-postgres.
HOTE_BASE_DE_DONNEES=localhost
PORT_BASE_DE_DONNEES=5432
NOM_BASE_DE_DONNEES=paie_server
UTILISATEUR_BASE_DE_DONNEES=paie_server

# Mot de passe PostgreSQL.
# Utilisez une valeur longue en production.
MOT_DE_PASSE_BASE_DE_DONNEES=remplacer_par_un_mot_de_passe_long

# Nombre maximum de connexions ouvertes vers PostgreSQL.
# 10 suffit pour l'environnement de developpement.
MAX_CONNEXIONS_BASE_DE_DONNEES=10

# Compte Wave affiche au client sur la page de paiement.
# Le client envoie l'argent directement au marchand sur ce compte.
NOM_COMPTE_WAVE=Nom du marchand
NUMERO_COMPTE_WAVE=+2250000000000

# Compte Orange Money affiche au client sur la page de paiement.
NOM_COMPTE_ORANGE=Nom du marchand
NUMERO_COMPTE_ORANGE=+2250000000000
